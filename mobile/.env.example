# Copia este archivo a mobile/.env (no versionado) y rellena los valores reales.

# Web Client ID de Google Cloud Console (el mismo configurado como Auth:Google:Audience en el backend).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Base URL de la API accesible desde el dispositivo/emulador:
#   - Emulador Android (AVD): http://10.0.2.2:5080
#   - Dispositivo físico (USB o misma red Wi-Fi): http://<IP-LAN-del-PC>:5080
EXPO_PUBLIC_API_BASE_URL=
