{
  "expo": {
    "name": "PadelMatch",
    "slug": "padelmatch",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F4EE",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.padelmatch.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ]
  }
}
